# Local environments, caches and credentials
.venv/
__pycache__/
.pytest_cache/
*.py[cod]
.env
.env.*
!.env.example
.agents/
.codex/
.aws/

# Generated experiments and the persistent API budget ledger stay local.
# Do not delete the ledger to reset the current debugging allowance.
/results/*
!/results/.gitkeep

# Local Chinese notes and historical review documents
*.zh.md
/reviews/
/OSI-hack.md
/web/web.md
/cases/devices/devices.md

# Restore the exact upstream code/data with tools/fetch_device_runtime.py.
# Keep provenance, licenses and attribution in Git; exclude the download cache.
/vendor/chemlab/*
!/vendor/chemlab/manifest.json
!/vendor/chemlab/expansion-code-manifest.json
!/vendor/chemlab/expansion-data-manifest.json
!/vendor/chemlab/LICENSE
!/vendor/chemlab/LICENSE-ASSETS.md
!/vendor/chemlab/NOTICE.md

# Publication boundary: retain experiment evidence and drafts locally.
*.log
/docs/evidence/
/docs/plans/
/docs/status/
/docs/demos/
/docs/reports/*
!/docs/reports/instrument-evaluation-report.html
!/docs/reports/assets/
/docs/reports/assets/*
!/docs/reports/assets/benchmark-suite-contribution-v3.png
!/docs/reports/assets/compact-mcqa-summary-v2.svg
!/docs/reports/assets/instrument-mcqa-categories-v2.svg
!/docs/reports/assets/instrument-mcqa-summary-v2.svg
!/docs/reports/assets/instrument-workflow-summary.pdf
!/docs/reports/assets/instrument-workflow-summary.png
!/docs/reports/assets/instrument-workflow-summary.svg
!/docs/reports/assets/teacher-forced-model-comparison-v2.svg
!/docs/reports/assets/workflow-contribution-v2.png
/output/*
!/output/pdf/
/output/pdf/*
!/output/pdf/instrument-evaluation-report.pdf
