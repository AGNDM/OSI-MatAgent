{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Instrument sequential evaluator episode",
  "description": "Native evaluator output, not a model answer key. Offline scoring aggregates original proposal grades and checks consistency. Private evaluator metadata and grades must not be added to a model's public view/history.",
  "type": "object",
  "required": ["task_id", "mode"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["teacher_forced", "free_run"]},
    "status": {"enum": ["ok", "infrastructure_error"], "default": "ok"},
    "error": {"type": "string", "minLength": 1},
    "trajectory_outcome_met": {"type": "boolean"},
    "menu_membership_verified": {"const": true},
    "autonomous_success": {"type": ["boolean", "null"]},
    "corrected_trajectory_outcome_met": {"type": ["boolean", "null"]},
    "decision_records": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["decision_index", "proposal_correct", "auxiliary_query", "corrected", "proposed_action", "response"],
        "properties": {
          "decision_index": {"type": "integer", "minimum": 1},
          "proposal_correct": {"type": "boolean"},
          "auxiliary_query": {"type": "boolean"},
          "corrected": {"type": "boolean"},
          "checkpoint_id": {"type": ["string", "null"]},
          "stage": {"type": ["string", "null"]},
          "proposed_action": {"type": "object"},
          "executed_action": {"type": ["object", "null"]},
          "response": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "infrastructure_error"}}, "required": ["status"]},
      "then": {"required": ["error"]},
      "else": {"required": ["decision_records", "trajectory_outcome_met", "menu_membership_verified"]}
    }
  ],
  "additionalProperties": true
}
